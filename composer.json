{
    "name": "nico-bary/teaspace-panel",
    "description": "TeaSpeak hosting customer panel",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/GreenTeaSpeak/ts3phpframework"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "guzzlehttp/guzzle": "^6.5 || ^7.0",
        "plesk/api-php-lib": "^1.1 || ^2.0",
        "phpmailer/phpmailer": "^6.5",
        "mollie/mollie-api-php": "^2.0",
        "planetteamspeak/ts3-php-framework": "1.3.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
